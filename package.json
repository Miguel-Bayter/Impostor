{
  "name": "impostor-monorepo",
  "private": true,
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/backend --filter ./apps/frontend dev",
    "build": "pnpm -r --filter ./apps/backend --filter ./apps/frontend build",
    "lint:check": "pnpm -r --filter ./apps/backend --filter ./apps/frontend lint:check",
    "lint:fix": "pnpm -r --filter ./apps/backend --filter ./apps/frontend lint:fix",
    "lint": "pnpm lint:check",
    "test": "pnpm -r --filter ./apps/backend --filter ./apps/frontend test",
    "types:check": "pnpm --filter ./apps/backend types:check && pnpm --filter ./apps/frontend types:check",
    "type-check": "pnpm types:check",
    "check-types": "pnpm types:check",
    "validate": "pnpm -r --parallel --filter ./apps/backend --filter ./apps/frontend validate",
    "format:check": "pnpm -r --filter ./apps/backend --filter ./apps/frontend format:check",
    "format:fix": "pnpm -r --filter ./apps/backend --filter ./apps/frontend format:fix",
    "format": "pnpm format:fix"
  }
}
